# CHPP application credentials (reuse your existing Hattrick CHPP app).
# These two identify the app and are all you need to start — run the login
# flow to obtain the access token (see below).
HATTRICK_CONSUMER_KEY=
HATTRICK_CONSUMER_SECRET=

# Access token/secret. You normally do NOT set these by hand: run the login
# flow once to authorize and cache them to credentials.json —
#   pnpm --filter hattrick-mcp login         (or: npx hattrick-login)
#   pnpm --filter hattrick-team-photo login
# It prints an authorize URL, you paste back the PIN, and the token is saved.
# Set these only to override the cached file, or to reuse a token you already
# have (e.g. the one the Go hattrick-mcp wrote).
# HATTRICK_ACCESS_TOKEN=
# HATTRICK_ACCESS_SECRET=

# Where the login flow reads/writes the cached token (default ./credentials.json).
# HATTRICK_CREDENTIALS=credentials.json

# MCP HTTP serve mode only: bearer token required to expose the server.
# HATTRICK_MCP_TOKEN=
# HATTRICK_MCP_ADDR=:8080

# Team-photo player-page proxy: OPTIONAL. Player pages are public, so this is
# only a fallback if you hit anti-scrape throttling on bulk fetches.
# HATTRICK_COOKIE=
