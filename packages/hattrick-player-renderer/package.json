{
  "name": "hattrick-player-renderer",
  "version": "0.0.0",
  "description": "Render a Hattrick full-body player figure by player id, driving Hattrick's own slimkitrender with runtime-fetched assets. No CHPP, no OAuth.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "fetch-faces": "node scripts/fetch-faces.mjs"
  }
}
