{
  "name": "hattrick-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker: serves the team-photo and player-renderer static builds and a same-origin /team-photo/api (per-user CHPP OAuth with encrypted-cookie sessions).",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "pnpm --filter hattrick-team-photo --filter renderer-studio build",
    "deploy": "pnpm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hattrick-chpp": "workspace:*",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "wrangler": "^3.95.0"
  }
}
