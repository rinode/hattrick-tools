{
  "name": "hattrick-mcp",
  "version": "0.0.0",
  "description": "An MCP server exposing read-only Hattrick CHPP data (team, players, economy, training, avatars) to AI assistants. Node port of the Go hattrick-mcp.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "hattrick-mcp": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "login": "node dist/cli.js login",
    "bundle:mcpb": "tsup --config tsup.mcpb.config.ts",
    "pack:mcpb": "pnpm bundle:mcpb && node scripts/pack-mcpb.mjs"
  },
  "files": [
    "dist",
    "knowledge",
    "manifest.json"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "hattrick-chpp": "workspace:*",
    "hattrick-core": "workspace:*",
    "zod": "^3.24.1"
  }
}
